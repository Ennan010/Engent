PORT=3001

# 本地开发默认 SQLite；切换 PostgreSQL 时改为 postgres://user:pass@host:5432/dbname
DATABASE_URL=sqlite://./data/engent.sqlite
# SQLite 存储路径（可选，默认 backend/data/engent.sqlite）
# SQLITE_PATH=./data/engent.sqlite

# Authing 应用 JWKS 地址（在 Authing 控制台 → 应用配置中获取）
AUTHING_JWKS_URI=https://engent.authing.cn/oidc/.well-known/jwks.json

# 智谱对话补全 API 地址（默认智谱；可替换为任意 OpenAI 兼容 Chat Completions 服务）
GLM_CHAT_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

# 智谱 GLM API Key（https://open.bigmodel.cn 控制台 → API Keys 获取，切勿提交真实值）
GLM_47_Flash_API_KEY=your_glm_api_key
GLM_46V_Flash_API_KEY=your_glm_api_key

# 候选文本模型（逗号分隔）：全部为智谱免费模型，后端自动测速排序，最快优先
GLM_TEXT_MODELS=glm-4.5-flash,glm-4.7-flash,glm-4-flash-250414,glm-4-flash

# Embedding API 地址（默认硅基流动；可替换为任意 OpenAI 兼容 /embeddings 服务）
EMBEDDING_MODEL_URL=https://api.siliconflow.cn/v1/embeddings

# 硅基流动 Embedding API Key（https://cloud.siliconflow.cn 获取，用于知识库向量化）
EMBEDDING_MODEL_API=sk-your_siliconflow_key
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# RAG 检索参数：相似度阈值（低于视为不相关，不注入上下文）、每次返回块数
RAG_MIN_SCORE=0.35
RAG_TOP_K=5
